---
import TranslateIcon from '@phosphor-icons/core/assets/regular/translate.svg';
import { localeMeta, type Lang } from '../i18n/config';
import { getOtherLangs, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  alternatePath: string;
}

const { lang, alternatePath } = Astro.props;
const t = useTranslations(lang);

// Con dos idiomas basta un enlace directo al otro. Si se añade un tercero,
// este componente pasa a ser una lista con un enlace por idioma.
const [target] = getOtherLangs(lang);
---

{
  target && (
    <a
      href={alternatePath}
      hreflang={localeMeta[target].htmlLang}
      class="lang-switch"
      data-lang-switch
    >
      <TranslateIcon width="18" height="18" aria-hidden="true" />
      <span aria-hidden="true">{target.toUpperCase()}</span>
      <span class="sr-only">{t('lang.switchTo', { language: t(`lang.${target}`) })}</span>
    </a>
  )
}

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding-inline: 0.625rem;
    border-radius: var(--radius-ui);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted);
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  .lang-switch:hover {
    color: var(--fg);
    background-color: var(--surface-raised);
  }
</style>
