---
import ArrowDownIcon from '@phosphor-icons/core/assets/regular/arrow-down.svg';
import ChartBarIcon from '@phosphor-icons/core/assets/regular/chart-bar.svg';
import CloudArrowDownIcon from '@phosphor-icons/core/assets/regular/cloud-arrow-down.svg';
import DatabaseIcon from '@phosphor-icons/core/assets/regular/database.svg';
import FunnelIcon from '@phosphor-icons/core/assets/regular/funnel.svg';
import PlugsConnectedIcon from '@phosphor-icons/core/assets/regular/plugs-connected.svg';

/**
 * Infografía tipo "cheat sheet" de un concepto de ingeniería de datos.
 * Es HTML y SVG (nítida y accesible en el sitio) y tiene proporción 4:5 a
 * 540 px de ancho, para exportarla como PNG de 1080 × 1350 y publicarla en
 * LinkedIn (ver `scripts/export_infografia.mjs`).
 *
 * El texto llega por props desde el MDX de la nota: el componente solo pinta.
 */
interface Stage {
  title: string;
  does: string;
  example: string;
}

interface Pillar {
  title: string;
  text: string;
}

interface Props {
  id: string;
  label: string;
  title: string;
  definition: string;
  stages: Stage[];
  pillarsTitle: string;
  pillars: Pillar[];
  author: string;
  site: string;
}

const { id, label, title, definition, stages, pillarsTitle, pillars, author, site } = Astro.props;
const icons = [PlugsConnectedIcon, CloudArrowDownIcon, FunnelIcon, DatabaseIcon, ChartBarIcon];
---

<figure id={id} class="cheatsheet not-prose" aria-labelledby={`${id}-title`}>
  <header>
    <h2 id={`${id}-title`} class="cheatsheet-title">{title}</h2>
    <p class="cheatsheet-definition">{definition}</p>
  </header>

  <ol class="cheatsheet-stages">
    {
      stages.map((stage, i) => {
        const Icon = icons[i % icons.length]!;
        return (
          <li class="cheatsheet-stage">
            <span class="cheatsheet-icon" aria-hidden="true">
              <Icon width="22" height="22" />
            </span>
            <div>
              <h3 class="cheatsheet-stage-title">{stage.title}</h3>
              <p class="cheatsheet-does">{stage.does}</p>
              <p class="cheatsheet-example">{stage.example}</p>
            </div>
            {i < stages.length - 1 && (
              <span class="cheatsheet-arrow" aria-hidden="true">
                <ArrowDownIcon width="14" height="14" />
              </span>
            )}
          </li>
        );
      })
    }
  </ol>

  <section class="cheatsheet-pillars" aria-labelledby={`${id}-pillars`}>
    <h3 id={`${id}-pillars`} class="cheatsheet-pillars-title">{pillarsTitle}</h3>
    <ul>
      {
        pillars.map((pillar) => (
          <li>
            <strong>{pillar.title}</strong>
            <span>{pillar.text}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <footer class="cheatsheet-footer">
    <span>{label} · {author}</span>
    <span>{site}</span>
  </footer>
</figure>

<style>
  .cheatsheet {
    max-width: 34rem;
    margin-block: 2.5rem;
    padding: 1.75rem 1.5rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background-color: var(--surface);
    color: var(--fg);
  }

  .cheatsheet-title {
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .cheatsheet-definition {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .cheatsheet-stages {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .cheatsheet-stage {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem;
    align-items: start;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.5rem;
    background-color: var(--bg);
  }

  .cheatsheet-icon {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    background-color: var(--accent-soft);
    color: var(--accent);
  }

  .cheatsheet-stage-title {
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .cheatsheet-does {
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .cheatsheet-example {
    margin-top: 0.125rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--muted);
  }

  /* Flecha entre etapas, centrada sobre el hueco de la cuadrícula. */
  .cheatsheet-arrow {
    position: absolute;
    left: 2.05rem;
    bottom: -0.75rem;
    display: inline-flex;
    width: 1rem;
    height: 0.75rem;
    align-items: center;
    justify-content: center;
    color: var(--line-strong);
  }

  .cheatsheet-pillars {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .cheatsheet-pillars-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
  }

  .cheatsheet-pillars ul {
    display: grid;
    gap: 0.5rem 1rem;
    margin-top: 0.625rem;
  }

  @media (min-width: 30rem) {
    .cheatsheet-pillars ul {
      grid-template-columns: 1fr 1fr;
    }
  }

  .cheatsheet-pillars li {
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .cheatsheet-pillars strong {
    display: block;
    font-weight: 650;
  }

  .cheatsheet-pillars span {
    color: var(--muted);
  }

  .cheatsheet-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
  }
</style>
