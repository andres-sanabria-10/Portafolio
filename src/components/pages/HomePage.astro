---
import ArrowRightIcon from '@phosphor-icons/core/assets/regular/arrow-right.svg';
import DownloadIcon from '@phosphor-icons/core/assets/regular/download-simple.svg';
import LinkedinIcon from '@phosphor-icons/core/assets/regular/linkedin-logo.svg';
import { Image } from 'astro:assets';
import portrait from '../../assets/profile.png';
import { site } from '../../config/site';
import type { Lang } from '../../i18n/config';
import { getRoutePath, useTranslations } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocalizedCollection } from '../../lib/collections';
import EmptyState from '../EmptyState.astro';
import EntryList from '../EntryList.astro';
import FeaturedProjects from '../FeaturedProjects.astro';
import StackSection from '../StackSection.astro';
import PipelineFlow from '../vue/PipelineFlow.vue';
import type { PipelineStage } from '../vue/pipeline';

/**
 * Inicio: hero, animación del pipeline, proyectos destacados, últimas notas
 * de Aprende y stack agrupado por etapa.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const featured = (await getLocalizedCollection('proyectos', lang))
  .filter(({ entry }) => entry.data.featured)
  .slice(0, 3);
const latestNotes = (await getLocalizedCollection('aprende', lang)).slice(0, 3);

const stageIds = ['source', 'ingest', 'transform', 'store', 'serve'] as const;
const stages: PipelineStage[] = stageIds.map((id) => ({
  id,
  label: t(`home.pipeline.${id}`),
  detail: t(`home.pipeline.${id}.detail`),
}));

// Nombres de columna en snake_case, como en una tabla de esquema.
const profile = [
  { column: 'role', value: t('home.profile.role') },
  { column: 'location', value: t('home.profile.location') },
  { column: 'work_mode', value: t('home.profile.mode') },
  { column: 'focus', value: t('home.profile.focus') },
  { column: 'learning', value: t('home.profile.learning') },
];
---

<BaseLayout lang={lang} title={t('home.title')} description={t('site.description')} fullTitle>
  <section class="container-page grid gap-12 pb-16 pt-14 md:pt-20 lg:grid-cols-[1.6fr_1fr] lg:items-end lg:gap-16 lg:pb-24">
    <div>
      <h1 class="text-3xl font-semibold sm:text-5xl">
        {t('home.hero.title')}
      </h1>
      <p class="mt-6 font-mono text-sm sm:text-base">
        <span class="text-muted">{t('home.hero.from')}</span>
        <span class="mx-1 text-accent">→</span>
        <span>{t('home.hero.to')}</span>
      </p>
      <p class="mt-4 max-w-xl text-lg text-muted">{t('home.hero.lead')}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={getRoutePath('projects', lang)} class="btn btn-primary">
          {t('home.cta.projects')}
          <ArrowRightIcon width="18" height="18" aria-hidden="true" />
        </a>
        <a href={site.cv} class="btn btn-secondary" download>
          <DownloadIcon width="18" height="18" aria-hidden="true" />
          {t('home.cta.cv')}
        </a>
        <a href={site.linkedin} class="btn btn-secondary" rel="me noopener">
          <LinkedinIcon width="18" height="18" aria-hidden="true" />
          {t('home.cta.linkedin')}
        </a>
      </div>
    </div>

    <div>
      <div class="mb-6 flex items-center gap-4">
        <Image
          src={portrait}
          alt={t('about.photo.alt')}
          widths={[112, 224]}
          sizes="112px"
          width={224}
          height={224}
          quality={92}
          loading="eager"
          fetchpriority="high"
          class="aspect-square w-28 shrink-0 rounded-ui border border-line bg-raised object-cover"
        />
        <div>
          <p class="text-lg font-semibold leading-snug">{site.author}</p>
          <p class="label-mono mt-1">{t('home.card.role')}</p>
        </div>
      </div>
      <table class="w-full border-y border-line text-sm">
        <caption class="sr-only">{t('home.profile.caption')}</caption>
        <tbody class="divide-y divide-line">
          {
            profile.map(({ column, value }) => (
              <tr>
                <th scope="row" class="label-mono w-32 py-3 pr-4 text-left font-normal">
                  {column}
                </th>
                <td class="py-3">{value}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="border-y border-line bg-surface" aria-labelledby="pipeline-title">
    <div class="container-page py-14 md:py-20">
      <div class="max-w-2xl">
        <h2 id="pipeline-title" class="text-2xl font-semibold md:text-3xl">
          {t('home.pipeline.title')}
        </h2>
        <p class="mt-4 text-muted">{t('home.pipeline.body')}</p>
      </div>
      <div class="mt-10 md:mt-12">
        <PipelineFlow
          client:visible
          stages={stages}
          label={t('home.pipeline.label')}
          pauseLabel={t('home.pipeline.pause')}
          playLabel={t('home.pipeline.play')}
          rawLabel={t('home.pipeline.raw')}
          validatedLabel={t('home.pipeline.validated')}
        />
      </div>
    </div>
  </section>

  <section class="container-page pb-12 pt-16 md:pt-20" aria-labelledby="featured-title">
    <div class="mb-8 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <h2 id="featured-title" class="text-2xl font-semibold md:text-3xl">{t('home.featured.title')}</h2>
      <a href={getRoutePath('projects', lang)} class="link text-sm">{t('home.featured.all')}</a>
    </div>
    {
      featured.length > 0 ? (
        <FeaturedProjects lang={lang} items={featured} />
      ) : (
        <EmptyState
          title={t('projects.empty.title')}
          body={t('projects.empty.body')}
          headingLevel={3}
        />
      )
    }
  </section>

  <section class="container-page py-12" aria-labelledby="latest-title">
    <div class="mb-8 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
      <h2 id="latest-title" class="text-2xl font-semibold md:text-3xl">{t('home.latest.title')}</h2>
      <a href={getRoutePath('learn', lang)} class="link text-sm">{t('home.latest.all')}</a>
    </div>
    {
      latestNotes.length > 0 ? (
        <EntryList collection="aprende" lang={lang} items={latestNotes} headingLevel={3} />
      ) : (
        <EmptyState title={t('learn.empty.title')} body={t('learn.empty.body')} headingLevel={3} />
      )
    }
  </section>

  <section class="container-page pb-20 pt-12 md:pb-24" aria-labelledby="stack-title">
    <div class="mb-10 max-w-2xl">
      <h2 id="stack-title" class="text-2xl font-semibold md:text-3xl">{t('home.stack.title')}</h2>
      <p class="mt-3 text-muted">{t('home.stack.body')}</p>
    </div>
    <StackSection lang={lang} />
  </section>
</BaseLayout>
